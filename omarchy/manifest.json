{
  "schemaVersion": 1,
  "id": "yux.whisper",
  "name": "Whisper Dictation",
  "version": "1.0.0",
  "author": "yux",
  "license": "MIT",
  "description": "Fast Thai and English voice-to-text dictation powered by Groq Whisper and GPT-OSS text correction, dual-mode triggering, and bottom-center OSD overlay for Omarchy Linux.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Whisper Dictation",
    "description": "Voice-to-text dictation with AI correction",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "showOsd": true,
      "correctText": false,
      "language": "th"
    },
    "schema": [
      {
        "key": "correctText",
        "type": "boolean",
        "label": "AI Text Correction (GPT-OSS)",
        "defaultValue": false
      },
      {
        "key": "showOsd",
        "type": "boolean",
        "label": "Show Floating OSD while dictating",
        "defaultValue": true
      }
    ]
  }
}
